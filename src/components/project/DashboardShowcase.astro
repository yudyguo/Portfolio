---
interface Props {
  variant?: 'light' | 'dark';
}

const { variant = 'dark' } = Astro.props;
const isDark = variant === 'dark';
---

<section class:list={[
  'py-20 md:py-32',
  isDark ? 'bg-surface-dark' : 'bg-surface-light',
]}>
  <div class="max-w-7xl mx-auto px-6 md:px-10">
    <div class="mb-6" data-gsap="fade-up">
      <div class="flex gap-6 mb-4">
        <span class:list={['text-sm', isDark ? 'text-text-muted' : 'text-text-secondary']}>Library</span>
        <span class:list={[
          'text-sm font-medium border-b pb-1',
          isDark ? 'text-text-on-dark border-text-on-dark' : 'text-text-primary border-text-primary',
        ]}>Optimization</span>
      </div>
      <h2 class:list={[
        'font-serif text-2xl md:text-4xl font-semibold',
        isDark ? 'text-text-on-dark' : 'text-text-primary',
      ]}>
        Customer service dashboard optimization
      </h2>
      <p class:list={[
        'text-lg mt-4',
        isDark ? 'text-text-muted' : 'text-text-secondary',
      ]}>
        Improve capabilities and provide Data-overview.
      </p>
    </div>

    <!-- Results metrics row -->
    <div class="grid grid-cols-3 gap-4 md:gap-8 mt-12 mb-16" data-gsap="stagger-children">
      <div class="text-center">
        <p class="font-serif text-3xl md:text-5xl font-bold text-accent-green"
           data-counter="37" data-counter-prefix="+" data-counter-suffix="%">+0%</p>
        <p class:list={['text-sm mt-2', isDark ? 'text-text-muted' : 'text-text-secondary']}>Response rate</p>
      </div>
      <div class="text-center">
        <p class="font-serif text-3xl md:text-5xl font-bold text-accent-green"
           data-counter="24" data-counter-prefix="+" data-counter-suffix="%">+0%</p>
        <p class:list={['text-sm mt-2', isDark ? 'text-text-muted' : 'text-text-secondary']}>Customer Satisfaction</p>
      </div>
      <div class="text-center">
        <p class="font-serif text-3xl md:text-5xl font-bold text-accent-red"
           data-counter="18" data-counter-prefix="-" data-counter-suffix="%">-0%</p>
        <p class:list={['text-sm mt-2', isDark ? 'text-text-muted' : 'text-text-secondary']}>Churn Rate</p>
      </div>
    </div>

    <!-- Dashboard screenshots -->
    <div class="grid md:grid-cols-3 gap-6" data-gsap="stagger-children">
      <!-- PC Dashboard -->
      <div class="md:col-span-2 rounded-xl overflow-hidden shadow-2xl" data-gsap="reveal-image">
        <div class="bg-surface-darker aspect-[16/10] flex items-center justify-center relative p-4">
          <div class="w-full h-full bg-white/5 rounded-lg border border-white/10 flex flex-col p-4">
            <div class="flex gap-3 mb-4">
              <div class="text-center">
                <p class="text-xs text-text-muted">Sessions</p>
                <p class="text-lg font-bold text-text-on-dark">142</p>
              </div>
              <div class="text-center">
                <p class="text-xs text-text-muted">Users</p>
                <p class="text-lg font-bold text-text-on-dark">36</p>
              </div>
              <div class="text-center">
                <p class="text-xs text-text-muted">Response</p>
                <p class="text-lg font-bold text-text-on-dark">86%</p>
              </div>
              <div class="text-center">
                <p class="text-xs text-text-muted">Avg Time</p>
                <p class="text-lg font-bold text-text-on-dark">10min</p>
              </div>
              <div class="text-center">
                <p class="text-xs text-text-muted">15-min Rate</p>
                <p class="text-lg font-bold text-text-on-dark">90%</p>
              </div>
            </div>
            <!-- Chart line placeholder -->
            <div class="flex-1 relative">
              <svg class="w-full h-full" viewBox="0 0 400 120" preserveAspectRatio="none">
                <polyline points="0,100 60,90 120,85 180,50 240,60 300,30 360,25 400,20" fill="none" stroke="#07C160" stroke-width="2" />
              </svg>
            </div>
          </div>
          <p class:list={['absolute bottom-2 text-xs', isDark ? 'text-text-muted' : 'text-text-secondary']}>PC Data Dashboard</p>
        </div>
      </div>

      <!-- Mobile + Agent panels -->
      <div class="flex flex-col gap-6">
        <!-- Mobile Dashboard -->
        <div class="rounded-xl overflow-hidden shadow-xl bg-white/5 border border-white/10 p-4" data-gsap="reveal-image">
          <div class="grid grid-cols-3 gap-2 text-center mb-3">
            <div><p class="text-[10px] text-text-muted">Sessions</p><p class="text-sm font-bold text-text-on-dark">134</p></div>
            <div><p class="text-[10px] text-text-muted">Users</p><p class="text-sm font-bold text-text-on-dark">134</p></div>
            <div><p class="text-[10px] text-text-muted">Response</p><p class="text-sm font-bold text-text-on-dark">5.37%</p></div>
          </div>
          <svg class="w-full h-16" viewBox="0 0 200 60" preserveAspectRatio="none">
            <polyline points="0,50 30,45 60,40 90,20 120,30 150,15 180,10 200,8" fill="none" stroke="#07C160" stroke-width="1.5" />
          </svg>
          <p class="text-xs text-text-muted text-center mt-2">Mobile Dashboard</p>
        </div>

        <!-- Agent panel -->
        <div class="rounded-xl overflow-hidden shadow-xl bg-white/5 border border-white/10 p-4" data-gsap="reveal-image">
          <p class="text-xs text-text-muted mb-3">Customer Data</p>
          <div class="space-y-2">
            <div class="flex justify-between text-xs text-text-on-dark"><span>xinzhezhan</span><span>1280</span></div>
            <div class="flex justify-between text-xs text-text-on-dark"><span>fayetao</span><span>1280</span></div>
            <div class="flex justify-between text-xs text-text-on-dark"><span>瑞秋和扎克</span><span>1280</span></div>
            <div class="flex justify-between text-xs text-text-on-dark"><span>YY</span><span>3543</span></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
