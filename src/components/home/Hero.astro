---
import GradientBlob from '../global/GradientBlob.astro';
---

<section class="relative min-h-screen flex flex-col justify-center overflow-hidden px-6 md:px-10 pt-20">
  <!-- Blobs matching the PDF cover -->
  <GradientBlob color="yellow" size="xl" class="top-[-5%] right-[-10%]" parallaxSpeed={1.2} />
  <GradientBlob color="lavender" size="md" class="bottom-[20%] left-[-5%]" parallaxSpeed={0.8} />
  <GradientBlob color="lavender" size="lg" class="bottom-[5%] right-[20%]" parallaxSpeed={1.0} />
  <GradientBlob color="yellow" size="lg" class="bottom-[-5%] right-[10%]" parallaxSpeed={0.6} />

  <div class="max-w-7xl mx-auto w-full relative z-10">
    <!-- Main title -->
    <h1 class="font-serif font-semibold leading-[0.95] tracking-tight mb-12" id="hero-title">
      <span class="block text-[clamp(3.5rem,10vw,9rem)]" aria-label="Portfolio">
        <span class="inline-block hero-char" style="--i:0">P</span><span class="inline-block hero-char" style="--i:1">o</span><span class="inline-block hero-char" style="--i:2">r</span><span class="inline-block hero-char" style="--i:3">t</span><span class="inline-block hero-char" style="--i:4">f</span><span class="inline-block hero-char" style="--i:5">o</span><span class="inline-block hero-char" style="--i:6">l</span><span class="inline-block hero-char" style="--i:7">i</span><span class="inline-block hero-char" style="--i:8">o</span>
      </span>
    </h1>

    <!-- Bottom info row -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 mt-auto" data-gsap="fade-up">
      <div>
        <p class="text-xl md:text-2xl font-medium text-text-primary">Yadi Guo</p>
        <p class="text-text-secondary mt-1">1220 Vienna, Austria</p>
      </div>
      <div class="text-right">
        <p class="text-text-secondary">+43 677 62317415</p>
        <a href="mailto:yudyguo@gmail.com" class="text-text-primary hover:text-accent-green transition-colors">
          yudyguo@gmail.com
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-text-muted" data-gsap="fade-up">
    <span class="text-xs tracking-widest uppercase">Scroll</span>
    <div class="w-px h-8 bg-text-muted/40 animate-pulse"></div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('astro:page-load', () => {
    const chars = document.querySelectorAll('.hero-char');
    if (chars.length === 0) return;

    const ctx = gsap.context(() => {
      gsap.fromTo(chars,
        { y: 120, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 1,
          ease: 'power3.out',
          stagger: 0.05,
          delay: 0.3,
          clearProps: 'opacity,transform',
        },
      );
    });

    document.addEventListener('astro:before-swap', () => ctx.revert(), { once: true });
  });
</script>
