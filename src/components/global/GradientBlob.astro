---
interface Props {
  color?: 'yellow' | 'lavender';
  size?: 'sm' | 'md' | 'lg' | 'xl';
  class?: string;
  parallaxSpeed?: number;
}

const {
  color = 'yellow',
  size = 'md',
  class: className = '',
  parallaxSpeed = 1,
} = Astro.props;

const sizeClasses: Record<string, string> = {
  sm: 'w-32 h-32 md:w-48 md:h-48',
  md: 'w-48 h-48 md:w-72 md:h-72',
  lg: 'w-64 h-64 md:w-96 md:h-96',
  xl: 'w-80 h-80 md:w-[30rem] md:h-[30rem]',
};

const colorClass = color === 'yellow'
  ? 'bg-[radial-gradient(circle,_#F6D365_0%,_transparent_70%)]'
  : 'bg-[radial-gradient(circle,_#C4B5FD_0%,_transparent_70%)]';
---

<div
  class:list={[
    'rounded-full blur-[60px] opacity-60 absolute pointer-events-none',
    sizeClasses[size],
    colorClass,
    className,
  ]}
  data-parallax={parallaxSpeed}
  aria-hidden="true"
></div>
