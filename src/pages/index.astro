---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/global/Navbar.astro';
import Footer from '../components/global/Footer.astro';
import Hero from '../components/home/Hero.astro';
import ProjectCard from '../components/home/ProjectCard.astro';
import ContactSection from '../components/home/ContactSection.astro';
import '../styles/global.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout>
  <Navbar />

  <main>
    <!-- Hero Section -->
    <Hero />

    <!-- Selected Projects -->
    <section class="py-20 md:py-32 px-6 md:px-10">
      <div class="max-w-7xl mx-auto">
        <div class="mb-12" data-gsap="fade-up">
          <p class="text-xs uppercase tracking-widest text-text-muted mb-2">Selected Work</p>
          <h2 class="font-serif text-3xl md:text-4xl font-semibold">Projects</h2>
        </div>

        <div class="grid md:grid-cols-2 gap-8" data-gsap="stagger-children">
          <ProjectCard
            title="WeChat Official Accounts Data Panel"
            subtitle="Redesigning the landing page data panel with user research-driven data prioritization"
            role="UX Research & Design"
            href={`${base}/project1`}
            image={`${base}/images/project1/cover.jpg`}
            index={0}
          />
          <ProjectCard
            title="WeChat Unified Customer Service System"
            subtitle="Unifying cross-platform experiences with a component library and scenario-based optimization"
            role="Design System & Optimization"
            href={`${base}/project2`}
            image={`${base}/images/project2/cover.jpg`}
            index={1}
          />
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <ContactSection />
  </main>

  <Footer />
</BaseLayout>
